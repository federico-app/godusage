{
  "sourceLanguage": "en",
  "strings": {
    " · %lld days left": {
      "localizations": {
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " · %lld giorno rimasto"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " · %lld giorni rimasti"
                }
              }
            }
          }
        }
      }
    },
    "%@ %@ of %@ this week": {
      "comment": "A week with a claimed limit reset: the use (each stretch between resets, added up), then the week's capacity, e.g. ↻ 95% + 40% of 200% this week",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ su %3$@ questa settimana"
          }
        }
      }
    },
    "%@ (You)": {
      "comment": "The signed-in user's own row in the leaderboard",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (tu)"
          }
        }
      }
    },
    "%@ ahead of pace": {
      "comment": "Live Pace pill; the value is a duration, e.g. 22 min",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sopra il ritmo"
          }
        }
      }
    },
    "%@ champion: top spender of the month": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Campione di %@: chi ha speso di più nel mese"
          }
        }
      }
    },
    "%@ drop to %@.": {
      "comment": "Live Pace note: the next working days' budget goes down, e.g. Wed–Mon drop to 18.4%",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ scendono a %@."
          }
        }
      }
    },
    "%@ more today on budget · resets %@": {
      "comment": "Points left in today's budget; when the weekly limit resets.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ancora %@ oggi nel budget · reset %@"
          }
        }
      }
    },
    "%@ of %@ today": {
      "comment": "Today's use, bold, against today's budget.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ di %@ oggi"
          }
        }
      }
    },
    "%@ on %@.": {
      "comment": "Live Pace note on a day off: the next working days' budget, e.g. 18.4% on Wed–Mon",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per %@."
          }
        }
      }
    },
    "%@ over today": {
      "comment": "Live Pace pill: how far today's use went past today's budget, e.g. 6.3% over today",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oltre oggi"
          }
        }
      }
    },
    "%@ over today's budget · resets %@": {
      "comment": "Points over today's budget; when the weekly limit resets.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oltre il budget di oggi · reset %@"
          }
        }
      }
    },
    "%@ rise to %@.": {
      "comment": "Live Pace note: the next working days' budget goes up, e.g. Wed–Mon rise to 18.4%",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ salgono a %@."
          }
        }
      }
    },
    "%@ under pace": {
      "comment": "Live Pace pill; the value is a duration, e.g. 2h 40m",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sotto il ritmo"
          }
        }
      }
    },
    "%@ used today": {
      "comment": "Today's use, bold.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usato oggi"
          }
        }
      }
    },
    "%@%@": {
      "shouldTranslate": false
    },
    "%@–%@": {
      "comment": "A range of weekdays, e.g. Wed–Mon",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@–%2$@"
          }
        }
      }
    },
    "%lld active now": {
      "comment": "Leaderboard header: members spending fast right now",
      "localizations": {
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld attivo ora"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld attivi ora"
                }
              }
            }
          }
        }
      }
    },
    "%lld min": {
      "comment": "A duration in minutes, e.g. 44 min",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min"
          }
        }
      }
    },
    "%lldh %@m": {
      "comment": "A duration in hours and minutes, e.g. 1h 05m",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldh %@m"
          }
        }
      }
    },
    "+%@ last hour": {
      "comment": "Spend in the last hour, under a member's bar.",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "+%@ ultima ora"
