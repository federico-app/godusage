    "Today": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi"
          }
        }
      }
    },
    "Today’s budget is used up, on the last working day before the reset.": {
      "comment": "Live Pace note: today's use reached today's budget exactly",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il budget di oggi è esaurito, nell’ultima giornata lavorativa prima dell’azzeramento."
          }
        }
      }
    },
    "Today’s budget is used up. More today comes out of the next working days.": {
      "comment": "Live Pace note: today's use reached today's budget exactly",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il budget di oggi è esaurito. Ciò che usi in più si toglie dalle prossime giornate lavorative."
          }
        }
      }
    },
    "Today’s budget is used up. The %@ comes out of the next working days.": {
      "comment": "Live Pace note; the value is the percentage over today's budget",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Budget di oggi superato di %@: si toglie dalle prossime giornate lavorative."
          }
        }
      }
    },
    "Today’s budget used up": {
      "comment": "Live Pace pill: today's use reached today's budget exactly, nothing over yet",
      "localizations": {
        "it": {
