      }
    },
    "The GodUsage server sent a response this app couldn’t read. Update the app and try again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server di GodUsage ha inviato una risposta che l’app non riesce a leggere. Aggiorna l’app e riprova."
          }
        }
      }
    },
    "The Keychain refused the GodUsage sign-in (error %d).": {
