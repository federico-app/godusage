      }
    },
    "The GodUsage server had a problem (HTTP %lld). Try again later.": {
      "comment": "An HTTP status code, e.g. 500",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server di GodUsage ha avuto un problema (HTTP %lld). Riprova più tardi."
          }
