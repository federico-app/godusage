{
  "name": "godusage-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:services": "docker compose -f docker-compose.test.yml -p godusage-backend-test up -d --wait",
    "test:services:down": "docker compose -f docker-compose.test.yml -p godusage-backend-test down -v",
    "build:server": "esbuild server/main.ts --bundle --platform=node --target=node24 --format=esm --external:pg-native --banner:js=\"import { createRequire } from \\\"node:module\\\"; const require = createRequire(import.meta.url);\" --outfile=dist/server.mjs",
    "start:server": "node dist/server.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "~4.1"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "redis": "^6.3.0"
  }
}
