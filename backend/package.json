{
  "name": "godusage-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run && vitest run --config vitest.node.config.ts",
    "deploy:dev": "wrangler deploy --env dev",
    "migrate": "wrangler d1 migrations apply godusage --remote",
    "migrate:dev": "wrangler d1 migrations apply godusage-dev --env dev --remote",
    "build:server": "esbuild server/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/server.mjs",
    "start:server": "node dist/server.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^24.19.1",
    "@vitest/runner": "~4.1",
    "@vitest/snapshot": "~4.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "~4.1",
    "wrangler": "^4.147.0"
  }
}
