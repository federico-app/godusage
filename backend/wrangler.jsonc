{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "godusage-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    // Bundle IDs whose Sign in with Apple identity tokens are accepted (release, then dev build).
    "APPLE_AUDIENCES": "com.montinovo.godusage,com.montinovo.godusage.dev",
    // Where the invite page sends people who do not have the app yet.
    "DOWNLOAD_URL": "https://github.com/federico-app/godusage/releases/latest",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "godusage",
      // Replace with the id printed by `npx wrangler d1 create godusage` before the first deploy.
      "database_id": "7b70362b-aba7-4535-a1bf-beb32015da65",
      "migrations_dir": "migrations",
    },
  ],
}
